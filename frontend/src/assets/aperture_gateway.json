{
  "version": "0.3.0",
  "name": "aperture_gateway",
  "instructions": [
    {
      "name": "initializeConfig",
      "accounts": [
        { "name": "config", "isMut": true, "isSigner": false },
        { "name": "authority", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [{ "name": "treasury", "type": "publicKey" }]
    },
    {
      "name": "openChannel",
      "accounts": [
        { "name": "config", "isMut": false, "isSigner": false },
        { "name": "channel", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [{ "name": "initialDeposit", "type": "u64" }]
    },
    {
      "name": "topUp",
      "accounts": [
        { "name": "channel", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [{ "name": "amount", "type": "u64" }]
    },
    {
      "name": "updateBurnRate",
      "accounts": [
        { "name": "config", "isMut": false, "isSigner": false },
        { "name": "channel", "isMut": true, "isSigner": false },
        { "name": "aiAgent", "isMut": false, "isSigner": true },
        { "name": "treasury", "isMut": true, "isSigner": false }
      ],
      "args": [{ "name": "newRate", "type": "u64" }]
    },
    {
      "name": "closeChannel",
      "accounts": [
        { "name": "config", "isMut": false, "isSigner": false },
        { "name": "channel", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "treasury", "isMut": true, "isSigner": false }
      ],
      "args": []
    }
  ],
  "accounts": [
    {
      "name": "ProtocolConfig",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "authority", "type": "publicKey" },
          { "name": "oracle", "type": "publicKey" },
          { "name": "treasury", "type": "publicKey" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "ChannelState",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "user", "type": "publicKey" },
          { "name": "oracle", "type": "publicKey" },
          { "name": "balance", "type": "u64" },
          { "name": "burnRate", "type": "u64" },
          { "name": "lastUpdateTime", "type": "i64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
  "events": [
    {
      "name": "BurnRateUpdatedEvent",
      "fields": [
        { "name": "user", "type": "publicKey", "index": false },
        { "name": "newRate", "type": "u64", "index": false },
        { "name": "chargedAmount", "type": "u64", "index": false },
        { "name": "remainingBalance", "type": "u64", "index": false },
        { "name": "timestamp", "type": "i64", "index": false }
      ]
    }
  ],
  "errors": [
    { "code": 6000, "name": "MathOverflow", "msg": "Arithmetic overflow occurred during balance calculation" },
    { "code": 6001, "name": "InsufficientBalance", "msg": "Channel has insufficient balance for operation" },
    { "code": 6002, "name": "UnauthorizedOracle", "msg": "Only the channel's configured oracle may update its burn rate" },
    { "code": 6003, "name": "InvalidOracle", "msg": "A payment channel requires a valid oracle public key" },
    { "code": 6004, "name": "InvalidTreasury", "msg": "The configured treasury public key is invalid" },
    { "code": 6005, "name": "BurnRateTooHigh", "msg": "The requested burn rate exceeds the protocol maximum" },
    { "code": 6006, "name": "ChannelBusy", "msg": "A payment channel cannot be topped up while a task is running" }
  ]
}
