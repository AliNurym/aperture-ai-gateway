{
  "version": "0.2.0",
  "name": "aperture_gateway",
  "instructions": [
    {
      "name": "openChannel",
      "accounts": [
        { "name": "channel", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "initialDeposit", "type": "u64" }
      ]
    },
    {
      "name": "topUp",
      "accounts": [
        { "name": "channel", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    },
    {
      "name": "updateBurnRate",
      "accounts": [
        { "name": "channel", "isMut": true, "isSigner": false },
        { "name": "aiAgent", "isMut": false, "isSigner": true }
      ],
      "args": [
        { "name": "newRate", "type": "u64" }
      ]
    },
    {
      "name": "closeChannel",
      "accounts": [
        { "name": "channel", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "treasury", "isMut": true, "isSigner": false }
      ],
      "args": []
    }
  ],
  "accounts": [
    {
      "name": "ChannelState",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "user", "type": "publicKey" },
          { "name": "balance", "type": "u64" },
          { "name": "burnRate", "type": "u64" },
          { "name": "lastUpdateTime", "type": "i64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
  "errors": [
    { "code": 6000, "name": "MathOverflow", "msg": "Arithmetic overflow occurred during balance calculation" },
    { "code": 6001, "name": "InsufficientBalance", "msg": "Channel has insufficient balance for operation" }
  ]
}