# Worker-only credentials. Keep this file separate from backend/.env.
# In staging/production, match this token to this worker ID in APERTURE_WORKER_CREDENTIALS.
APERTURE_NODE_ID=NODE-CPU-LOCAL
APERTURE_WORKER_TOKEN=replace-with-a-long-random-secret

# For the local Windows worker. Docker Compose overrides this with http://gateway:8000.
GATEWAY_API_URL=http://127.0.0.1:8000
