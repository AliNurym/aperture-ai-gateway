# Aperture AI — Sentinel Oracle Configuration
# Solana Network Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=A5HfdyRWy77i5DxhTMBa1ZinxVGZbVZnb35EvXUvkNzQ
# Public authority key pinned into the Anchor build and checked by the gateway.
# Use a protected signing wallet; the backend signer must match it for initialization.
APERTURE_CONFIG_AUTHORITY=
APERTURE_TREASURY_PUBKEY=

# Runtime mode. Never enable demo mode on an internet-accessible gateway.
APERTURE_ENV=development
APERTURE_DEMO_MODE=false

# Production/staging: configure a JSON allowlist of worker IDs and distinct 32+ character secrets.
# The Compose worker's ID is NODE-CPU-COMPOSE; its secret must match backend/.worker.env.
# APERTURE_WORKER_CREDENTIALS={"NODE-CPU-COMPOSE":"replace-with-a-long-random-secret"}
# Development-only fallback for a single trusted local worker; ignored when the allowlist is set.
APERTURE_WORKER_TOKEN=replace-with-a-long-random-secret
BACKEND_PRIVATE_KEY=

# Comma-separated browser origins allowed to call the gateway.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APERTURE_MAX_PENDING_TASKS=100
APERTURE_MAX_ACTIVE_TASKS=200
APERTURE_MAX_LOG_BYTES_PER_TASK=1000000
APERTURE_MAX_REQUEST_BYTES=2500000
# Worker result JSON has a separate bounded limit because logs expand when escaped.
APERTURE_MAX_RESULT_REQUEST_BYTES=16000000
APERTURE_QUEUE_TTL_SECONDS=300
APERTURE_MAX_COMPLETED_TASKS=1000
# Optional initial rate published by a worker process, lamports per second.
# Provider owners can change the rate later in Provide compute.
APERTURE_WORKER_RATE_LAMPORTS_SEC=1000
# Private immutable objects default to a sibling of APERTURE_STATE_DB.
# Keep the database and objects on persistent storage.
# APERTURE_OBJECT_STORE=C:\aperture-data\objects
# Optional: absolute path to operator-configured inference offers (no API keys).
# Set the same file on gateway and --inference-only workers; see docs/inference.md.
APERTURE_INFERENCE_CONFIG=

# Optional: local unified preview only. Copy this file to backend/.env and fill
# one model key to enable AI Sentinel and model inference. The preview reads only
# these allowlisted settings and passes each key to its inference worker, not to
# the browser or gateway.
GEMINI_API_KEY=
APERTURE_GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=
APERTURE_DEEPSEEK_MODEL=deepseek-flash
