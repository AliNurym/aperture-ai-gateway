# Aperture AI — Sentinel Oracle Configuration
# Solana Network Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=A5HfdyRWy77i5DxhTMBa1ZinxVGZbVZnb35EvXUvkNzQ
# Public authority key pinned into the Anchor build and checked by the gateway.
# Use a protected signing wallet; the backend signer must match it for initialization.
APERTURE_CONFIG_AUTHORITY=
APERTURE_TREASURY_PUBKEY=

# Runtime mode. Never enable demo mode on an internet-accessible gateway.
APERTURE_ENV=development
APERTURE_DEMO_MODE=false

# Long random secret shared only with approved worker nodes. Generate with a password manager.
APERTURE_WORKER_TOKEN=replace-with-a-long-random-secret
BACKEND_PRIVATE_KEY=

# Comma-separated browser origins allowed to call the gateway.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APERTURE_MAX_PENDING_TASKS=100
APERTURE_MAX_STREAM_LINES_PER_TASK=10000
APERTURE_MAX_LOG_BYTES_PER_TASK=1000000
APERTURE_MAX_COMPLETED_TASKS=1000
APERTURE_TASK_LEASE_SECONDS=210
APERTURE_EXECUTE_RATE_LIMIT=10
APERTURE_FAUCET_RATE_LIMIT=3
APERTURE_RATE_LIMIT_WINDOW_SECONDS=60

# Optional Helius RPC / Compression Key for compressed NFT minting on Devnet.
HELIUS_API_KEY=

# API Server Port
PORT=8000

# Worker / Gateway Connection (Defaults to local)
GATEWAY_API_URL=http://127.0.0.1:8000
