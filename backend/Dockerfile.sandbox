FROM python:3.12-slim

# Deterministic CPU analytics available to agent jobs; no API keys or network.
RUN pip install --no-cache-dir numpy==2.2.6 && useradd --uid 10001 --no-create-home aperture
USER 10001:10001
WORKDIR /tmp
ENV PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ENTRYPOINT ["python", "-I", "-u"]
